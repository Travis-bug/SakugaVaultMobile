<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episodeRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_episode"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/epNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/sv_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/epStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Now playing"
        android:textColor="@color/sv_accent_soft"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/epChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Play episode"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/sv_muted" />
</LinearLayout>
